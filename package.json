{
    "name": "samir.cx",
    "version": "2.0.0",
    "repository": "https://github.com/SamirTheSWE/samir.cx.git",
    "author": "contact@samir.cx",
    "license": "MIT",
    "private": true,
    "packageManager": "yarn@1.22.22",
    "scripts": {
        "postinstall": "husky",
        "format": "prettier --write .",
        "lint": "eslint .",
        "lint:fix": "yarn format && yarn lint --fix",
        "dev": "next dev --turbopack",
        "build": "next build",
        "start": "next start"
    },
    "lint-staged": {
        "*": [
            "yarn format"
        ],
        "*.ts": [
            "yarn lint:fix"
        ]
    },
    "dependencies": {
        "next": "16.2.10",
        "react": "19.2.7",
        "react-dom": "19.2.7"
    },
    "devDependencies": {
        "@eslint/eslintrc": "3.3.6",
        "@eslint/js": "10.0.1",
        "@next/eslint-plugin-next": "16.2.10",
        "@tailwindcss/postcss": "4.3.2",
        "@trivago/prettier-plugin-sort-imports": "6.0.2",
        "@tsparticles/engine": "4.3.2",
        "@tsparticles/react": "^4.3.2",
        "@tsparticles/slim": "4.3.2",
        "@types/node": "26.1.1",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "eslint": "10.7.0",
        "eslint-config-next": "16.2.10",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.6",
        "husky": "^9.1.7",
        "lint-staged": "17.0.8",
        "motion": "12.42.2",
        "postcss": "8.5.18",
        "prettier": "3.9.5",
        "prettier-plugin-tailwindcss": "0.8.0",
        "react-icons": "5.7.0",
        "tailwindcss": "4.3.2",
        "tsparticles": "4.3.2",
        "typescript": "7.0.2",
        "typescript-eslint": "8.63.0"
    }
}
